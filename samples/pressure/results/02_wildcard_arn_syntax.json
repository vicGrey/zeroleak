{
  "policy_file": "02_wildcard_arn_syntax.json",
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "OverpermissiveObjectAccess",
        "Effect": "Allow",
        "Action": [
          "s3:GetObject",
          "s3:PutObject"
        ],
        "Resource": "arn:aws:s3:::*/*"
      }
    ]
  },
  "conftest_gate": {
    "valid_json": true,
    "passed": false,
    "violation_count": 1,
    "violations": [
      {
        "rule": "no_wildcard_resource",
        "message": "[Rule: no_wildcard_resource] Statement (Sid: 'OverpermissiveObjectAccess') permits wildcard object resource ('arn:aws:s3:::*/*'). S3 object resources must scope bucket namespaces explicitly."
      }
    ]
  },
  "gemma_audit": {
    "success": true,
    "threat_explanation": "The resource pattern arn:aws:s3:::*/* allows read and write operations against all objects in all S3 buckets within the account.",
    "combination_risks": [],
    "has_suggested_fix": true,
    "suggested_fix": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "ScopedObjectAccess",
          "Effect": "Allow",
          "Action": [
            "s3:GetObject",
            "s3:PutObject"
          ],
          "Resource": "arn:aws:s3:::my-application-bucket/*"
        }
      ]
    }
  }
}