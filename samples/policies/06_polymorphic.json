{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ActionAsStringWildcard",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "arn:aws:sqs:us-east-1:123456789012:billing-events"
    },
    {
      "Sid": "ActionAsArrayWithEmbeddedWildcard",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "*"
      ],
      "Resource": "arn:aws:s3:::audit-logs/*"
    }
  ]
}
